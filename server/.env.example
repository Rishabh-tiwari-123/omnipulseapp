# OmniPulse v5 Production Server Environment Configuration Template
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas free tier M0 or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<db_password>@cluster0.xxxxxxx.mongodb.net/omnipulse?retryWrites=true&w=majority

# Google Gemini API Key for Pulse-AI Health Concierge
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Dynamic Treasury & Unit Economics Locks
DAILY_COIN_CAP=35
REFERRAL_BONUS_COINS=50
TREASURY_PAYOUT_POOL_RATIO=0.60

# Google AdMob Server-Side Verification (SSV) Key/Secret
ADMOB_SECRET_KEY=your_admob_ssv_shared_secret_key

# Admin Secret Token for Dashboard Routes
ADMIN_API_KEY=omnipulse_admin_secret_key_v5

# Client Base URL
VITE_API_BASE_URL=http://localhost:5000/api/v1
